# Copy this file to .env and fill in your values.
# Never commit .env to Git.

DATABASE_URL=postgresql://user:password@host:5432/dbname

# Batch / concurrency (keep low for 512 MB Render instance)
SCRAPER_BATCH_SIZE=5
MAX_LOCATION_ATTEMPTS=3
LOCATION_WORKERS=1
CTX_POOL_SIZE=1
DETAIL_WORKERS=1
MAX_RESULTS=30

# Which category to scrape (must match a matchers/<category>.yaml file)
SCRAPER_CATEGORY=mehendi_artist
SCRAPER_STATE=Jharkhand

# Minutes before a 'running' location is considered stale and reset to 'pending'
STALE_RUNNING_MINUTES=30
